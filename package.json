  "description": "Universal TP-Link Router Suite: Production CLI, React Ink TUI, and Model Context Protocol (MCP 2.x) Server",
  "main": "bin/tplink-cli.js",
  "bin": {
    "tplink-cli": "bin/tplink-cli.js",
