{
  "metadata": {
    "project": "universal-tplink-mcp",
    "router_model": "TP-Link Archer MR200 / MR6400 / MR600 Series",
    "firmware_engine": "uhttpd TR-064 / CGI GDPR Encrypted & Legacy",
    "target_ip": "192.168.1.1",
    "extracted_by": "Dulith Divisekara (SLIIT Malabe)",
    "total_web_pages": 95,
    "security_protocols": [
      "GDPR RSA-512 + AES-128-CBC + MD5",
      "Legacy Plain CGI / Basic Auth",
      "Single-Admin Session Token Lock (TokenID / JSESSIONID)"
    ]
  },
  "action_types": {
    "ACT_GET": 1,
    "ACT_SET": 2,
    "ACT_ADD": 3,
    "ACT_DEL": 4,
    "ACT_GL": 5,
    "ACT_GS": 6,
    "ACT_OP": 7,
    "ACT_CGI": 8
  },
